
‏@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap');

:root {
  --dark: #17251f;
  --green: #526b55;
  --light-green: #e8eee7;
  --cream: #f8f6f0;
  --white: #ffffff;
  --text: #333b35;
  --muted: #777e77;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Cairo', sans-serif;
  background: var(--cream);
  color: var(--text);
}

a {
  text-decoration: none;
  color: inherit;
}

button, input, select {
  font-family: inherit;
}

.navbar {
  height: 75px;
  padding: 0 8%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--white);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 15px #0000000a;
}

.logo {
  font-size: 25px;
  font-weight: 800;
  color: var(--dark);
  direction: ltr;
}

.logo span {
  color: var(--green);
}

.navbar nav {
  display: flex;
  gap: 30px;
}

.navbar nav a {
  font-size: 14px;
  font-weight: 600;
  transition: 0.3s;
}

.navbar nav a:hover {
  color: var(--green);
}

.menu-btn {
  display: none;
  border: 0;
  background: none;
  font-size: 25px;
  cursor: pointer;
}

.hero {
  min-height: 570px;
  display: flex;
  align-items: center;
  padding: 70px 10%;
  color: white;
  background:
    linear-gradient(90deg, #14231dcf, #14231d50),
    url('https://portalcdn.spa.gov.sa/backend/original/202504/nCLSyqaoEdhQCweYK0qtK6sQTAJSNNw54eeLuKUU.jpg')
    center/cover;
}

.hero-content {
  max-width: 570px;
}

.eyebrow {
  color: var(--green);
  font-size: 13px;
  font-weight: 800;
  margin-bottom: 12px;
}

.hero .eyebrow {
  color: #d9e8d8;
}

.hero h1 {
  font-size: clamp(38px, 6vw, 65px);
  line-height: 1.35;
  margin-bottom: 20px;
}

.hero p:not(.eyebrow) {
  line-height: 2;
  color: #eeeeee;
  margin-bottom: 30px;
}

.main-btn {
  display: inline-block;
  background: var(--green);
  color: white;
  border: none;
  padding: 13px 30px;
  border-radius: 7px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.3s;
}

.main-btn:hover {
  background: var(--dark);
  transform: translateY(-2px);
}

.section {
  padding: 85px 8%;
}

.section-heading {
  text-align: center;
  margin-bottom: 35px;
}

.section-heading h2,
.about-section h2 {
  font-size: 32px;
  color: var(--dark);
  margin-bottom: 10px;
}

.section-heading > p:last-child {
  color: var(--muted);
  font-size: 14px;
}

.search-area {
  display: flex;
  gap: 12px;
  margin: 30px auto;
  max-width: 750px;
}

.search-area input,
.search-area select,
.planner-card select {
  width: 100%;
  padding: 13px;
  border: 1px solid #e0e3dc;
  background: white;
  border-radius: 7px;
  outline: none;
  color: var(--text);
}

.search-area input:focus,
.search-area select:focus,
.planner-card select:focus {
  border-color: var(--green);
}

.places-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.place-card {
  background: white;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 5px 25px #00000009;
  transition: 0.3s;
}

.place-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px #00000012;
}

.place-card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  display: block;
}

.place-info {
  padding: 20px;
}

.place-info h3 {
  font-size: 19px;
  color: var(--dark);
  margin-bottom: 8px;
}

.place-info p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.9;
  min-height: 50px;
}

.place-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 18px;
}

.map-link {
  color: var(--green);
  font-weight: 700;
  font-size: 13px;
}

.favorite-btn {
  border: 1px solid #e4e4e4;
  background: white;
  border-radius: 7px;
  padding: 7px 12px;
  cursor: pointer;
  color: var(--green);
  font-size: 13px;
}

.planner-section {
  background: var(--light-green);
  padding: 85px 8%;
}

.planner-card {
  max-width: 600px;
  margin: auto;
  background: white;
  border-radius: 12px;
  padding: 30px;
  box-shadow: 0 5px 25px #00000008;
}

.planner-card label {
  display: block;
  font-weight: 700;
  font-size: 14px;
  margin: 18px 0 8px;
}

.full-btn {
  width: 100%;
  margin-top: 25px;
}

.trip-result {
  margin-top: 25px;
  line-height: 2;
}

.trip-result h3 {
  color: var(--green);
  margin-bottom: 10px;
}

.trip-result li {
  margin-right: 20px;
}

.about-section {
  padding: 90px 12%;
  text-align: center;
}

.about-section p:not(.eyebrow) {
  max-width: 750px;
  margin: 15px auto 0;
  line-height: 2.2;
  color: var(--muted);
}

footer {
  background: var(--dark);
  color: white;
  padding: 30px 8%;
  text-align: center;
}

footer .logo {
  color: white;
}

footer p {
  font-size: 12px;
  margin-top: 10px;
  color: #c6cec7;
}

.empty-message {
  grid-column: 1 / -1;
  text-align: center;
  color: var(--muted);
  padding: 30px;
}

@media (max-width: 850px) {
  .places-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .navbar {
    padding: 0 5%;
  }

  .navbar nav {
    gap: 15px;
  }
}

@media (max-width: 600px) {
  .navbar nav {
    display: none;
    position: absolute;
    top: 75px;
    right: 0;
    left: 0;
    background: white;
    padding: 20px;
    flex-direction: column;
    gap: 15px;
  }

  .navbar nav.show {
    display: flex;
  }

  .menu-btn {
    display: block;
  }

  .hero {
    min-height: 500px;
    padding: 50px 7%;
  }

  .section,
  .planner-section {
    padding: 60px 6%;
  }

  .places-grid {
    grid-template-columns: 1fr;
  }

  .search-area {
    flex-direction: column;
  }

  .section-heading h2,
  .about-section h2 {
    font-size: 26px;
  }

  .planner-card {
    padding: 20px;
  }
}
